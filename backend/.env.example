# Server
PORT=4000
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Database
DB_PATH=./data/tumya.db

# Payments
UPI_ID=your-upi-id@bank
UPI_PAYEE_NAME=Tumya
MOMO_NUMBER_PRIMARY=+256700000000
MOMO_NUMBER_SECONDARY=+256700000001

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Tumya <no-reply@yourdomain.com>

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:admin@yourdomain.com

# Optional
NODE_ENV=production